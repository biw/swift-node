{
  "name": "@swift-node-examples/hello-world-tsdown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vp test run"
  },
  "devDependencies": {
    "swift-node": "workspace:*",
    "swift-node-unplugin": "workspace:*",
    "tsdown": "0.22.14",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
