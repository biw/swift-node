{
  "name": "swift-node-unplugin",
  "version": "0.0.4",
  "description": "Unplugin adapters that build and bundle Swift Node native assets.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./rollup": {
      "import": {
        "types": "./dist/rollup.d.ts",
        "default": "./dist/rollup.js"
      },
      "require": {
        "types": "./dist/rollup.d.cts",
        "default": "./dist/rollup.cjs"
      }
    },
    "./rolldown": {
      "import": {
        "types": "./dist/rolldown.d.ts",
        "default": "./dist/rolldown.js"
      },
      "require": {
        "types": "./dist/rolldown.d.cts",
        "default": "./dist/rolldown.cjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/webpack.d.ts",
        "default": "./dist/webpack.js"
      },
      "require": {
        "types": "./dist/webpack.d.cts",
        "default": "./dist/webpack.cjs"
      }
    },
    "./esbuild": {
      "import": {
        "types": "./dist/esbuild.d.ts",
        "default": "./dist/esbuild.js"
      },
      "require": {
        "types": "./dist/esbuild.d.cts",
        "default": "./dist/esbuild.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/biw/swift-node.git",
    "directory": "packages/swift-node-unplugin"
  },
  "homepage": "https://github.com/biw/swift-node#readme",
  "bugs": {
    "url": "https://github.com/biw/swift-node/issues"
  },
  "keywords": [
    "swift",
    "node",
    "native",
    "unplugin",
    "vite",
    "rollup",
    "webpack",
    "esbuild",
    "tsdown",
    "rolldown"
  ],
  "author": "Ben Williams",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run"
  },
  "peerDependencies": {
    "swift-node": "^0.0.3"
  },
  "dependencies": {
    "unplugin": "3.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "esbuild": "0.21.5",
    "rollup": "4.60.0",
    "swift-node": "workspace:*",
    "tsdown": "0.22.14",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "webpack": "5.109.2"
  }
}
