        delete[] value;
        if (tsfn_created) {
            napi_release_threadsafe_function(callback_state->tsfn, napi_tsfn_abort);
            callback_state = nullptr;
        }
    };

    if (!swift_node_expect_type(env, argv[0], napi_string, "Expected argument 'value' to be a string")) { cleanup_args(); return nullptr; }
    if (!swift_node_napi_ok(env, napi_get_value_string_utf8(env, argv[0], nullptr, 0, &value_len), "Failed to read string argument length")) { cleanup_args(); return nullptr; }
    value = new char[value_len + 1];
