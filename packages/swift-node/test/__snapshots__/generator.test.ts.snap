    callback_state->env = env;
    if (!swift_node_napi_ok(env, napi_create_threadsafe_function(env, argv[1], nullptr, resource_name, 0, 1, callback_state, finalize_callback_regression_contract_notify, callback_state, call_js_regression_contract_notify, &callback_state->tsfn), "Failed to create threadsafe callback")) { delete callback_state; callback_state = nullptr; cleanup_args(); return nullptr; }
