    { std::lock_guard<std::mutex> lock(callbacks_mutex_regression_contract_notify); callbacks_regression_contract_notify.insert(callback_state); }
    tsfn_created = false;

    regression_contract_notify(value, value_len, trampoline_regression_contract_notify, callback_state);
    delete[] value;

