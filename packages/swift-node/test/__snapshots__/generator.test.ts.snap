    if (!swift_node_expect_type(env, argv[1], napi_function, "Expected argument 'callback' to be a function")) { cleanup_args(); return nullptr; }
    napi_value resource_name;
    if (!swift_node_napi_ok(env, napi_create_string_utf8(env, "swift_node_cb_regression_contract_notify", NAPI_AUTO_LENGTH, &resource_name), "Failed to create callback resource name")) { cleanup_args(); return nullptr; }
